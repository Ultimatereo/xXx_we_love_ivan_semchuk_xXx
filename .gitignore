.streamlit/

# Generated project data
/data/raw/*
!/data/raw/.gitkeep
/data/runs/*
!/data/runs/.gitkeep
/data/sorted/*
!/data/sorted/.gitkeep
/data/wal/*
!/data/wal/.gitkeep
/data/outputs/*
!/data/outputs/.gitkeep
